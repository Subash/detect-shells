  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Subash/detect-shells/issues"
  },
  "homepage": "https://github.com/Subash/detect-shells#readme",
  "dependencies": {
    "app-path": "^3.3.0",
    "registry-js": "^1.15.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
