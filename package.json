{
  "name": "detect-shells",
  "version": "4.1.0",
  "description": "Detect shells installed on a system",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "clean": "rm -rf lib",
    "compile": "tsc",
    "typecheck": "npm run compile && tsc -p tests --noEmit",
